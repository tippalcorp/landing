---
const steps = [
  {
    num: "01",
    title: "Set up once",
    body: "Create your account and add where you want tips to land. The download is free, and there's no terminal to buy.",
    chipBg: "var(--tippal-success-light)",
    chipFg: "var(--tippal-success-dark)",
    range: "entry 0% cover 25%",
  },
  {
    num: "02",
    title: "They just tap",
    body: "Whoever is tipping holds their card, Apple Pay, or Google Pay to your phone. No app to install, no screen to hand over.",
    chipBg: "var(--tippal-heart-soft)",
    chipFg: "var(--tippal-heart)",
    range: "entry 0% cover 32%",
  },
  {
    num: "03",
    title: "It's yours",
    body: "Every tip lands in your balance, ready to cash out to your bank or card.",
    chipBg: "var(--tippal-primary-light)",
    chipFg: "var(--tippal-primary)",
    range: "entry 0% cover 40%",
  },
];
---

<section id="how" class="how">
  <div class="how__inner">
    <header class="how__header">
      <h2 class="how__title">Get thanked in three steps</h2>
      <p class="how__sub">No terminal to buy, no screen to hand over, and nothing for them to download — they tap, you're thanked.</p>
    </header>
    <div class="how__cards">
      {steps.map((step, i) => (
        <div
          class={`how__card how__card--${i}`}
        >
          <div class="how__card-top">
            <span class="how__chip" style={`background:${step.chipBg};color:${step.chipFg}`}>
              {i === 0 && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7.5h18M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm2 9h5" />
                </svg>
              )}
              {i === 1 && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                  <path d="M12 21s-7.5-4.6-10-9.1C.4 8.6 2.3 5 5.7 5c2 0 3.4 1.1 4.3 2.3l2 2.7 2-2.7C15 6.1 16.3 5 18.3 5c3.4 0 5.3 3.6 3.7 6.9C19.5 16.4 12 21 12 21z" />
                </svg>
              )}
              {i === 2 && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20V8m0 0 5 5m-5-5-5 5" />
                </svg>
              )}
            </span>
            <span class="how__num">{step.num}</span>
          </div>
          <div class="how__card-title">{step.title}</div>
          <div class="how__card-body">{step.body}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how {
    padding: var(--tippal-space-section) 28px;
  }
  .how__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .how__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .how__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 48px);
    color: var(--tippal-accent);
  }
  .how__sub {
    margin: 0 auto;
    max-width: 50ch;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--tippal-text-secondary);
  }
  .how__cards {
    display: grid;
    grid-template-columns: 1.3fr 1fr 0.9fr;
    gap: 24px;
  }
  .how__card {
    background: #fff;
    border-radius: var(--tippal-radius-card);
    padding: 30px 26px;
    box-shadow: var(--tippal-shadow-card);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 250ms var(--tippal-ease-settle), box-shadow 250ms;
  }
  .how__card:hover {
    transform: scale(1.03);
    box-shadow: var(--tippal-shadow-float);
  }
  /* Mobile: collapse back to equal columns */
  @media (max-width: 720px) {
    .how__cards {
      grid-template-columns: 1fr;
    }
  }
  .how__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .how__chip {
    width: 52px;
    height: 52px;
    border-radius: var(--tippal-radius-tile);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .how__num {
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: 26px;
    color: var(--tippal-secondary);
  }
  .how__card-title {
    font-weight: 800;
    font-size: 20px;
    color: var(--tippal-accent);
  }
  .how__card-body {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--tippal-text-secondary);
  }
</style>
