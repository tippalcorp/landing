---
interface Props {
  language?: "en" | "es";
}

const { language = "en" } = Astro.props;
const copy = language === "es"
  ? {
      kicker: "Por qué existe TipPal",
      title: "La gratitud, sin presión",
      subtitle: "Una forma digital de agradecer en persona, con información clara antes de enviar.",
      cards: [
        { title: "Sin efectivo", body: "Envía gratitud con Tap to Pay, TipPal ID o un código QR." },
        { title: "Tú decides", body: "Elige si quieres enviar una propina y cuánto quieres dar." },
        { title: "Cargos a la vista", body: "Los cargos aplicables a transacciones, retiros o funciones premium se muestran antes de completar la acción." },
        { title: "Saldo y retiros", body: "Quien recibe puede consultar su saldo y las opciones de retiro disponibles en la app." },
      ],
      ctaTitle: "TipPal es para todos",
      ctaBody: "Para quienes quieren agradecer y para quienes reciben ese gesto.",
      ctaTagline: "Porque todos somos TipPal.",
    }
  : {
      kicker: "Why TipPal exists",
      title: "Gratitude, without the pressure",
      subtitle: "A digital way to say thanks in person, with clear information before you send.",
      cards: [
        { title: "No cash needed", body: "Send gratitude with Tap to Pay, TipPal ID, or a QR code." },
        { title: "You decide", body: "Choose whether to send a tip and how much you want to give." },
        { title: "Charges shown up front", body: "Applicable charges for transactions, withdrawals, or premium features are shown before you complete the action." },
        { title: "Balance and withdrawals", body: "Recipients can check their balance and available withdrawal options in the app." },
      ],
      ctaTitle: "TipPal is for everyone",
      ctaBody: "For everyone who wants to show gratitude and everyone who receives it.",
      ctaTagline: "Because we're all TipPal.",
    };
---

<section id="truth" class="truth">
  <div class="truth__inner">
    <header class="truth__header">
      <p class="truth__kicker">{copy.kicker}</p>
      <h2 class="truth__title">{copy.title}</h2>
      <p class="truth__subtitle">{copy.subtitle}</p>
    </header>

    <div class="truth__grid">
      {copy.cards.map((card, i) => (
        <article class={`truth__card truth__card--${i} scroll-reveal`}>
          <span class="truth__number">0{i + 1}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>

    <div class="truth__cta">
      <h2 class="truth__cta-title">{copy.ctaTitle}</h2>
      <p class="truth__cta-desc">{copy.ctaBody}</p>
      <p class="truth__cta-tagline">{copy.ctaTagline}</p>
    </div>
  </div>
</section>

<style>
  .truth {
    background: #fff;
    padding: 104px 28px 80px;
  }
  .truth__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 42px;
  }
  .truth__header {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .truth__kicker {
    margin: 0 0 10px;
    color: var(--tippal-secondary);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .truth__title,
  .truth__cta-title {
    margin: 0;
    color: var(--tippal-accent);
    font-family: var(--tippal-font-display);
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.12;
  }
  .truth__subtitle {
    max-width: 58ch;
    margin: 14px auto 0;
    color: var(--tippal-text-secondary);
    font-size: 17px;
    line-height: 1.6;
  }
  .truth__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .truth__card {
    min-height: 210px;
    padding: 24px 20px;
    border: 1px solid rgba(48, 0, 106, .08);
    border-radius: 20px;
    background: var(--tippal-background);
    box-shadow: var(--tippal-shadow-card);
  }
  .truth__number {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--tippal-primary);
    background: #fff;
    font-family: var(--tippal-font-display);
    font-size: 18px;
    font-weight: 700;
  }
  .truth__card h3 {
    margin: 22px 0 8px;
    color: var(--tippal-accent);
    font-size: 17px;
    line-height: 1.3;
  }
  .truth__card p {
    margin: 0;
    color: var(--tippal-text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }
  .truth__cta {
    padding: 38px 24px;
    border-radius: 24px;
    color: #fff;
    background: linear-gradient(135deg, var(--tippal-secondary), var(--tippal-accent) 80%);
    text-align: center;
  }
  .truth__cta-title { color: #fff; font-size: clamp(28px, 4vw, 40px); }
  .truth__cta-desc { margin: 12px 0 0; color: rgba(255,255,255,.86); font-size: 16px; line-height: 1.6; }
  .truth__cta-tagline { margin: 16px 0 0; color: var(--tippal-tertiary); font-weight: 700; }

  @media (max-width: 900px) {
    .truth__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .truth { padding: 76px 20px 60px; }
    .truth__grid { grid-template-columns: 1fr; }
    .truth__card { min-height: auto; }
  }
</style>
