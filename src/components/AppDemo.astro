---
import BalanceCard from "./BalanceCard.astro";
import TransactionItem from "./TransactionItem.astro";

export interface Props {
  title?: string;
  tapTitle?: string;
  tapDesc?: string;
  joinTitle?: string;
  joinDesc?: string;
  activityLabel?: string;
  balance?: string;
  balanceCaption?: string;
  withdrawLabel?: string;
  sentLabel?: string;
  receivedLabel?: string;
  transactions?: {
    type: "tip_sent" | "tip_received";
    amount: string;
    name: string;
    note: string;
    date: string;
  }[];
}

const {
  title = "Made for thank-yous",
  tapTitle = "Tap to Pay, in person",
  tapDesc = "They tap their phone to yours and it's done — no app on their side. Apple Pay, Google Pay, or a card. If they do have TipPal, a TipPal ID or QR code works too.",
  joinTitle = "Just an email to join",
  joinDesc = "Sign up with your email and start receiving appreciation right away. It takes about a minute.",
  activityLabel = "Recent activity",
  balance = "$128.50",
  balanceCaption = "Gratitude received",
  withdrawLabel = "Withdraw",
  sentLabel = "gratitude sent",
  receivedLabel = "gratitude received",
  transactions = [
    { type: "tip_sent", amount: "$5.00", name: "Maya R.", note: "Best latte in town", date: "Today, 2:14 PM" },
    { type: "tip_received", amount: "+$12.00", name: "Carlos R.", note: "Thanks for the ride", date: "Today, 11:02 AM" },
    { type: "tip_received", amount: "+$8.00", name: "Ana P.", note: "Room was spotless", date: "Yesterday" },
  ],
} = Astro.props;
---

<section class="demo">
  <div class="demo__grid">
    <!-- Left column -->
    <div class="demo__left">
      <h2 class="demo__title">{title}</h2>

      <div class="demo__card">
        <div class="demo__feature">
          <div>
            <div class="demo__feature-title">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--tippal-heart)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:8px">
                <path d="M6.5 8.5a8 8 0 0 1 0 7" />
                <path d="M10.5 6.5a11 11 0 0 1 0 11" />
                <path d="M14.5 4.5a14.5 14.5 0 0 1 0 15" />
              </svg>
              {tapTitle}
            </div>
            <div class="demo__feature-desc">{tapDesc}</div>
          </div>
        </div>
      </div>

      <div class="demo__card">
        <div class="demo__feature">
          <div>
            <div class="demo__feature-title">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--tippal-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:8px">
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="m3.5 7 8.5 6 8.5-6" />
              </svg>
              {joinTitle}
            </div>
            <div class="demo__feature-desc">{joinDesc}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: phone mockup -->
    <div class="demo__right">
      <div class="demo__phone">
        <!-- Notch -->
        <div class="demo__notch"><span></span></div>
        <!-- Balance card -->
        <BalanceCard balance={balance} caption={balanceCaption} actionLabel={withdrawLabel} />
        <!-- Recent activity -->
        <div class="demo__activity">
          <div class="demo__activity-label">{activityLabel}</div>
          {transactions.map((tx, i) => (
            <TransactionItem
              type={tx.type}
              amount={tx.amount}
              name={tx.name}
              note={tx.note}
              date={tx.date}
              isLast={i === transactions.length - 1}
              sentLabel={sentLabel}
              receivedLabel={receivedLabel}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo {
    background: linear-gradient(135deg, var(--tippal-secondary), var(--tippal-accent) 80%);
    position: relative;
    overflow: hidden;
    padding: var(--tippal-space-section) 28px;
  }
  .demo__grid {
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 64px;
    align-items: center;
  }
  .demo__left {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .demo__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 48px);
    color: #fff;
  }
  .demo__card {
    background: #fff;
    border-radius: var(--tippal-radius-card);
    padding: 22px 24px;
    box-shadow: var(--tippal-shadow-card);
  }
  .demo__feature {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .demo__feature-title {
    font-weight: 800;
    font-size: 16px;
    color: var(--tippal-accent);
  }
  .demo__feature-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--tippal-text-secondary);
    margin-top: 4px;
  }
  .demo__right {
    display: flex;
    justify-content: center;
  }
  .demo__phone {
    width: min(380px, 88vw);
    background: #fff;
    border-radius: var(--tippal-radius-device);
    padding: 18px;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.5);
  }
  .demo__notch {
    display: flex;
    justify-content: center;
    padding: 4px 0 14px;
  }
  .demo__notch span {
    width: 110px;
    height: 6px;
    border-radius: var(--tippal-radius-pill);
    background: var(--tippal-border-light);
  }
  .demo__activity {
    padding: 20px 6px 6px;
  }
  .demo__activity-label {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.3px;
    color: var(--tippal-text-tertiary);
    padding: 0 10px 6px;
  }
</style>
