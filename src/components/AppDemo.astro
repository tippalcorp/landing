---
import BalanceCard from "./BalanceCard.astro";
import TransactionItem from "./TransactionItem.astro";

interface Props {
  language?: "en" | "es";
}

const { language = "en" } = Astro.props;
const copy = language === "es"
  ? {
      title: "Hecho para agradecer",
      sample: "Pantalla de ejemplo · actividad ilustrativa",
      tapTitle: "Tap to Pay, en persona",
      tapDescription: "Acerca tu teléfono al de la otra persona y envía tu agradecimiento. También puedes usar Apple Pay, Google Pay, TipPal ID y códigos QR.",
      joinTitle: "Regístrate con tu correo",
      joinDescription: "Crea una cuenta con tu correo electrónico y empieza a recibir muestras de gratitud.",
      balance: "Gratitud recibida",
      withdraw: "Retirar",
      activity: "Actividad reciente",
      sentNote: "El mejor café de la ciudad",
      rideNote: "Gracias por el viaje",
      roomNote: "La habitación quedó impecable",
      today: "Hoy, 2:14 p. m.",
      morning: "Hoy, 11:02 a. m.",
      yesterday: "Ayer",
    }
  : {
      title: "Made for thank-yous",
      sample: "Sample screen · illustrative activity",
      tapTitle: "Tap to Pay, in person",
      tapDescription: "Tap your phone to theirs and send your gratitude. You can also use Apple Pay, Google Pay, TipPal ID, and QR codes.",
      joinTitle: "Just an email to join",
      joinDescription: "Create an account with your email and start receiving appreciation.",
      balance: "Gratitude received",
      withdraw: "Withdraw",
      activity: "Recent activity",
      sentNote: "Best latte in town",
      rideNote: "Thanks for the ride",
      roomNote: "Room was spotless",
      today: "Today, 2:14 PM",
      morning: "Today, 11:02 AM",
      yesterday: "Yesterday",
    };
---

<section class="demo">
  <div class="demo__grid">
    <!-- Left column -->
    <div class="demo__left">
      <h2 class="demo__title">{copy.title}</h2>

      <div class="demo__card">
        <div class="demo__feature">
          <div>
            <div class="demo__feature-title">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--tippal-heart)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:8px">
                <path d="M6.5 8.5a8 8 0 0 1 0 7" />
                <path d="M10.5 6.5a11 11 0 0 1 0 11" />
                <path d="M14.5 4.5a14.5 14.5 0 0 1 0 15" />
              </svg>
              {copy.tapTitle}
            </div>
            <div class="demo__feature-desc">{copy.tapDescription}</div>
          </div>
        </div>
      </div>

      <div class="demo__card">
        <div class="demo__feature">
          <div>
            <div class="demo__feature-title">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--tippal-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:8px">
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="m3.5 7 8.5 6 8.5-6" />
              </svg>
              {copy.joinTitle}
            </div>
            <div class="demo__feature-desc">{copy.joinDescription}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: phone mockup -->
    <div class="demo__right">
        <p class="demo__sample">{copy.sample}</p>
      <div class="demo__phone">
        <!-- Notch -->
        <div class="demo__notch"><span></span></div>
        <!-- Balance card -->
          <BalanceCard balance="$128.50" caption={copy.balance} actionLabel={copy.withdraw} />
        <!-- Recent activity -->
        <div class="demo__activity">
          <div class="demo__activity-label">{copy.activity}</div>
          <TransactionItem type="tip_sent" amount="$5.00" name="Maya R." note={copy.sentNote} date={copy.today} language={language} />
          <TransactionItem type="tip_received" amount="+$12.00" name="Carlos R." note={copy.rideNote} date={copy.morning} language={language} />
          <TransactionItem type="tip_received" amount="+$8.00" name="Ana P." note={copy.roomNote} date={copy.yesterday} language={language} isLast />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo {
    background: linear-gradient(135deg, var(--tippal-secondary), var(--tippal-accent) 80%);
    position: relative;
    overflow: hidden;
    padding: 104px 28px;
  }
  .demo__grid {
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 64px;
    align-items: center;
  }
  .demo__left {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .demo__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 48px);
    color: #fff;
  }
  .demo__card {
    background: #fff;
    border-radius: 18px;
    padding: 22px 24px;
    box-shadow: var(--tippal-shadow-card);
  }
  .demo__feature {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .demo__feature-title {
    font-weight: 800;
    font-size: 16px;
    color: var(--tippal-accent);
  }
  .demo__feature-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--tippal-text-secondary);
    margin-top: 4px;
  }
  .demo__right {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .demo__sample {
    position: absolute;
    top: -34px;
    left: 50%;
    width: max-content;
    max-width: 100%;
    margin: 0;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, .82);
    font-size: 12px;
    font-weight: 700;
    text-align: center;
  }
  .demo__phone {
    width: min(380px, 88vw);
    background: #fff;
    border-radius: 38px;
    padding: 18px;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.5);
  }
  .demo__notch {
    display: flex;
    justify-content: center;
    padding: 4px 0 14px;
  }
  .demo__notch span {
    width: 110px;
    height: 6px;
    border-radius: 9999px;
    background: var(--tippal-border-light);
  }
  .demo__activity {
    padding: 20px 6px 6px;
  }
  .demo__activity-label {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.3px;
    color: var(--tippal-text-tertiary);
    padding: 0 10px 6px;
  }
</style>
