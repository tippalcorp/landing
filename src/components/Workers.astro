---
interface Props {
  language?: "en" | "es";
}

const { language = "en" } = Astro.props;
const copy = language === "es"
  ? { title: "Hecho para quienes te hacen el día", description: "Baristas, valets, conductores, personal de hotel, creadores y todas las personas a quienes queremos agradecer.", alt: "Trabajadores de servicio recibiendo muestras de gratitud" }
  : { title: "Made for the people who make your day", description: "Baristas, valets, drivers, hotel staff, creators — and everyone who wants to show them real recognition.", alt: "Service workers receiving gratitude" };
---

<section id={language === "es" ? "personas" : "why"} class="workers">
  <div class="workers__inner">
    <h2 class="workers__title">{copy.title}</h2>
    <p class="workers__desc">{copy.description}</p>
    <img
      src="/assets/workers.png"
      alt={copy.alt}
      class="workers__img"
      loading="lazy"
    />
  </div>
</section>

<style>
  .workers {
    background: #fff;
    padding: 96px 28px 80px;
    margin-top: -8px;
  }
  .workers__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .workers__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 48px);
    color: var(--tippal-accent);
  }
  .workers__desc {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--tippal-text-secondary);
    text-wrap: pretty;
  }
  .workers__img {
    width: 100%;
    max-width: 890px;
    margin: 26px auto 0;
    display: block;
  }
</style>
