---
import StoreButton from "./StoreButton.astro";
---

<section id="get" class="manifesto">
  <div class="manifesto__inner">
    <h2 class="manifesto__title">Together, we stop Tipflation.</h2>
    <p class="manifesto__desc">
      Gratitude shouldn't feel like a toll at every checkout. TipPal takes the pressure out and keeps the gratitude real — gratitude is a gift, not a fee.
    </p>
    <div class="manifesto__stores">
      <StoreButton store="apple" size="lg" />
      <StoreButton store="google" href="https://play.google.com/store/apps/details?id=com.tippalcorp.app" size="lg" />
    </div>
  </div>
</section>

<style>
  .manifesto {
    padding: 120px 28px 96px;
    text-align: center;
  }
  .manifesto__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }
  .manifesto__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.1;
    color: var(--tippal-accent);
  }
  .manifesto__desc {
    margin: 0;
    max-width: 54ch;
    font-size: 18px;
    line-height: 1.65;
    color: var(--tippal-text-secondary);
    text-wrap: pretty;
  }
  .manifesto__stores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 8px;
  }
</style>
