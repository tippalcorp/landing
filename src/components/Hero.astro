---
import StoreButton from "./StoreButton.astro";
import TapToPayHero from "./TapToPayHero.astro";
---

<section id="top" class="hero">
  <div class="hero__grid">
    <!-- Left column -->
    <div class="hero__left">
      <h1 class="hero__title hero-anim" style="animation-delay:.1s">
        Gratitude is human.<br />No pressure.
      </h1>
      <p class="hero__tagline hero-anim" style="animation-delay:.15s">
        Receive instant gratitude in person with <span class="hero__tagline-accent">Tap to Pay</span>.
      </p>
      <p class="hero__desc hero-anim" style="animation-delay:.2s">
        TipPal is the easiest way to get tipped in person — and the person tipping doesn't need the app, just a card or their phone. Apple Pay, Google Pay, and Tap to Pay all land instantly.
      </p>
      <div class="hero__stores hero-anim" style="animation-delay:.3s">
        <StoreButton store="apple" href="https://apps.apple.com/us/app/tippal/id6806428593" />
        <StoreButton store="google" href="https://play.google.com/store/apps/details?id=com.tippalcorp.app" />
      </div>
      <div class="hero__micro hero-anim" style="animation-delay:.4s">
        Free to download · Every gift goes to people, not platforms
      </div>
    </div>
    <!-- Right column -->
    <div class="hero__right">
      <TapToPayHero />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--tippal-hero-surface);
    animation: kf-exit linear both;
    animation-timeline: view();
    animation-range: exit 0% exit 75%;
  }
  /* Grain layer: sits between the gradient and the content, never over it. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--tippal-hero-grain);
    opacity: 0.3;
    mix-blend-mode: soft-light;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin: 0 auto;
    padding: 76px 28px var(--tippal-space-section);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: center;
  }
  .hero__left {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero-anim {
    animation: kf-hero-in 0.7s var(--tippal-ease-settle) both;
  }
  .hero__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(42px, 5.4vw, 68px);
    line-height: 1.06;
    color: var(--tippal-accent);
  }
  .hero__desc {
    margin: 0;
    max-width: 46ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--tippal-text-secondary);
    text-wrap: pretty;
  }
  /* Co-equal Tap to Pay sub-headline — same DOM tier as the h1, not subordinate. */
  .hero__tagline {
    margin: 0;
    max-width: 16ch;
    font-family: var(--tippal-font-display);
    font-weight: 600;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.1;
    color: var(--tippal-accent);
  }
  .hero__tagline-accent {
    /* primary-dark, not primary: the hero surface carries a lilac bloom, and
       #0068d1 measures 4.46:1 on the deepest part of it (3.5:1 at the bloom's
       peak), which keeps the design lint red. */
    color: var(--tippal-primary-dark);
  }
  .hero__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  .hero__micro {
    font-size: 13.5px;
    font-weight: 600;
    /* Secondary, not tertiary: the micro line sits on the hero's warm wash,
       where tertiary (#716586) drops under 4.5:1. */
    color: var(--tippal-text-secondary);
  }
  .hero__right {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    animation: kf-pop 0.8s var(--tippal-ease-settle) 0.25s both;
  }
</style>
