---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
---

<StaticPageLayout
  title="Contact Us"
  seoTitle="TipPal — Contact Us"
  description="Get in touch with TipPal Corp. Support and privacy contact emails, plus quick links to account deletion and frequently asked questions."
  lastUpdated="August 10, 2026"
  canonicalURL="/contact"
  hreflang={{ en: "/contact", es: "/es/contact" }}
>
  <section>
    <p>We're here to help. Reach the TipPal team using the email addresses below, or jump straight to a self-service page.</p>
  </section>

  <section>
    <h3>Email us</h3>
    <ul>
      <li><strong>Support:</strong> <a href="mailto:support@tippalcorp.com">support@tippalcorp.com</a> — help with your account, payments, withdrawals, and the app.</li>
      <li><strong>Privacy:</strong> <a href="mailto:info@tippalcorp.com">info@tippalcorp.com</a> — data protection and privacy rights requests.</li>
    </ul>
    <p>Please send deletion and privacy requests from the email address registered to your TipPal account so we can verify your identity.</p>
  </section>

  <section>
    <h3>Quick links</h3>
    <ul>
      <li><a href="/delete-account">Delete your account</a> — step-by-step instructions for requesting account deletion.</li>
      <li><a href="/faq">Frequently asked questions</a> — answers to common questions about TipPal.</li>
      <li><a href="/security">Security</a> — how we protect your information and payments.</li>
      <li><a href="/legal#privacy">Privacy Policy</a> — full data handling and retention details.</li>
    </ul>
  </section>

  <section>
    <h3>Company</h3>
    <p>TipPal Corp<br />Florida, United States<br />Website: www.tippalcorp.com</p>
  </section>
</StaticPageLayout>