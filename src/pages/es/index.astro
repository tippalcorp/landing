---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeartIcon from "../../components/HeartIcon.astro";
import StoreButton from "../../components/StoreButton.astro";
import Footer from "../../components/Footer.astro";
---

<!-- TODO: human review ES copy -->
<BaseLayout
  title="TipPal — La gratitud es humana. Sin presión."
  description="TipPal es la forma más fácil de enviar gratitud en persona con Tap to Pay. La primera app hecha exclusivamente para agradecer a quienes te hacen el día."
  canonicalURL="/es"
  lang="es"
  hreflang={{ en: "/", es: "/es" }}
>
  <!-- Nav -->
  <nav class="nav" aria-label="Principal">
    <a href="/es" class="nav__logo">
      <img src="/assets/logo.png" alt="TipPal" height="44" />
    </a>
    <div class="nav__links">
      <a href="#como" class="nav__link">Cómo funciona</a>
      <a href="#por-que" class="nav__link">Por qué TipPal</a>
      <a href="#descargar" class="nav__cta">Descarga la app</a>
    </div>
  </nav>

  <!-- Hero -->
  <section id="top" class="hero">
    <div class="hero__grid">
      <div class="hero__left">
        <div class="hero__badge">
          <HeartIcon size={15} color="var(--tippal-heart)" />
          La primera app hecha exclusivamente para la gratitud
        </div>
        <h1 class="hero__title">
          La gratitud es humana.<br />Sin presión.
        </h1>
        <p class="hero__tagline">
          Envía y recibe gratitud en persona con <span class="hero__tagline-accent">Tap to Pay</span>.
        </p>
        <p class="hero__desc">
          TipPal es la forma más fácil de enviar gratitud en persona — con Apple Pay, Google Pay, TipPal ID (@email), códigos QR, Tap to Pay y más formas de conectar.
        </p>
        <div class="hero__stores">
          <StoreButton store="apple" />
          <StoreButton store="google" href="https://play.google.com/store/apps/details?id=com.tippalcorp.app" />
        </div>
        <p class="hero__micro">Se descarga gratis · Cada regalo llega a personas, no a plataformas</p>
      </div>

      <div class="hero__right">
        <div class="hero__card">
          <img
            src="/assets/hug.png"
            alt="Dos amigos abrazándose"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="como" class="how">
    <h2 class="how__title">Cómo funciona</h2>
    <div class="how__grid">
      <div class="how__step">
        <span class="how__num">1</span>
        <h3>Abre TipPal</h3>
        <p>Inicia la app y elige a quién quieres agradecer.</p>
      </div>
      <div class="how__step">
        <span class="how__num">2</span>
        <h3>Toca para pagar</h3>
        <p>Acerca tu teléfono y envía tu regalo con Tap to Pay.</p>
      </div>
      <div class="how__step">
        <span class="how__num">3</span>
        <h3>Gratitud entregada</h3>
        <p>La persona recibe tu agradecimiento de forma directa y transparente.</p>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section id="por-que" class="manifesto">
    <div class="manifesto__inner">
      <h2 class="manifesto__title">Juntos, frenamos la Tipflation.</h2>
      <p class="manifesto__desc">
        La gratitud no debería sentirse como un peaje en cada caja. TipPal quita la presión y mantiene la gratitud real — la gratitud es un regalo, no un cargo.
      </p>
      <div id="descargar" class="manifesto__stores">
        <StoreButton store="apple" size="lg" />
        <StoreButton store="google" href="https://play.google.com/store/apps/details?id=com.tippalcorp.app" size="lg" />
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 28px;
    background: rgba(243, 232, 255, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--tippal-border-light);
  }
  .nav__logo {
    display: flex;
    align-items: center;
  }
  .nav__logo img {
    height: 44px;
    display: block;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-weight: 700;
    font-size: 14.5px;
  }
  .nav__link {
    color: var(--tippal-accent);
  }
  .nav__cta {
    background: var(--tippal-primary);
    color: #fff;
    border-radius: 9999px;
    height: 44px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    box-shadow: var(--tippal-shadow-rest);
  }
  .nav__cta:hover {
    background: var(--tippal-primary-dark);
    color: #fff;
  }

  .hero__grid {
    max-width: 1140px;
    margin: 0 auto;
    padding: 56px 28px 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 48px;
    align-items: center;
  }
  .hero__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    background: #fff;
    border-radius: 9999px;
    padding: 8px 16px;
    box-shadow: var(--tippal-shadow-rest);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--tippal-accent);
  }
  .hero__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    color: var(--tippal-accent);
  }
  .hero__tagline {
    margin: 0;
    max-width: 16ch;
    font-family: var(--tippal-font-display);
    font-weight: 600;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.12;
    color: var(--tippal-accent);
  }
  .hero__tagline-accent {
    color: var(--tippal-primary);
  }
  .hero__desc {
    margin: 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--tippal-text-secondary);
  }
  .hero__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }
  .hero__micro {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tippal-text-tertiary);
  }
  .hero__right {
    display: flex;
    justify-content: center;
  }
  .hero__card {
    background: #fff;
    border-radius: 24px;
    padding: 28px 34px 60px;
    box-shadow: var(--tippal-shadow-float);
  }
  .hero__card img {
    width: min(280px, 56vw);
    display: block;
  }

  .how {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 28px 72px;
  }
  .how__title {
    margin: 0 0 32px;
    text-align: center;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(30px, 4vw, 44px);
    color: var(--tippal-accent);
  }
  .how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }
  .how__step {
    background: #fff;
    border-radius: 20px;
    padding: 28px 24px;
    box-shadow: var(--tippal-shadow-card);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .how__num {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--tippal-primary-light);
    color: var(--tippal-primary);
    font-weight: 800;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .how__step h3 {
    margin: 0;
    font-size: 19px;
    color: var(--tippal-accent);
  }
  .how__step p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--tippal-text-secondary);
  }

  .manifesto {
    padding: 96px 28px 88px;
    text-align: center;
  }
  .manifesto__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: center;
  }
  .manifesto__title {
    margin: 0;
    font-family: var(--tippal-font-display);
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.12;
    color: var(--tippal-accent);
  }
  .manifesto__desc {
    margin: 0;
    max-width: 54ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--tippal-text-secondary);
  }
  .manifesto__stores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 6px;
  }

  @media (max-width: 480px) {
    .nav__link {
      display: none;
    }
  }
</style>