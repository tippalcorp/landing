---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeartIcon from "../../components/HeartIcon.astro";
import Nav from "../../components/Nav.astro";
import StoreButton from "../../components/StoreButton.astro";
import HeroScroll from "../../components/HeroScroll.astro";
import Marquee from "../../components/Marquee.astro";
import Workers from "../../components/Workers.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import AppDemo from "../../components/AppDemo.astro";
import Manifesto from "../../components/Manifesto.astro";
import TheTruth from "../../components/TheTruth.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="TipPal — La gratitud es humana. Sin presión."
  description="Envía y recibe propinas digitales en persona con Tap to Pay, TipPal ID y códigos QR."
  canonicalURL="/es"
  ogImage="/og-es.png"
  lang="es"
  hreflang={{ en: "/", es: "/es" }}
>
  <Nav language="es" />
  <main>
    <section id="top" class="hero">
      <div class="hero__grid">
        <div class="hero__left">
          <div class="hero__badge">
            <HeartIcon size={15} color="var(--tippal-heart)" />
            La primera app hecha exclusivamente para la gratitud
          </div>
          <h1 class="hero__title">La gratitud es humana.<br />Sin presión.</h1>
          <p class="hero__tagline">
            Envía una propina digital y di gracias en persona con <span class="hero__tagline-accent">Tap to Pay</span>.
          </p>
          <p class="hero__desc">
            También puedes usar Apple Pay, Google Pay, TipPal ID (@email) y códigos QR para enviar gratitud.
          </p>
          <div class="hero__stores">
            <StoreButton store="apple" />
            <StoreButton store="google" href="https://play.google.com/store/apps/details?id=com.tippalcorp.app" />
          </div>
          <p class="hero__micro">Descarga gratis · Los cargos aplicables se muestran antes de completar una acción</p>
        </div>

        <div class="hero__right">
          <div class="hero__card">
            <img src="/assets/hug.png" alt="Dos amigos abrazándose" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <HeroScroll language="es" />
    <Marquee language="es" />
    <Workers language="es" />
    <HowItWorks language="es" />
    <AppDemo language="es" />
    <Manifesto language="es" />
    <TheTruth language="es" />
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero__grid {
    max-width: 1140px;
    margin: 0 auto;
    padding: 56px 28px 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 48px;
    align-items: center;
  }
  .hero__left { display: flex; flex-direction: column; gap: 20px; }
  .hero__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 9999px;
    color: var(--tippal-accent);
    background: #fff;
    box-shadow: var(--tippal-shadow-rest);
    font-size: 13.5px;
    font-weight: 700;
  }
  .hero__title {
    margin: 0;
    color: var(--tippal-accent);
    font-family: var(--tippal-font-display);
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 700;
    line-height: 1.08;
  }
  .hero__tagline {
    max-width: 22ch;
    margin: 0;
    color: var(--tippal-accent);
    font-family: var(--tippal-font-display);
    font-size: clamp(24px, 3.2vw, 38px);
    font-weight: 600;
    line-height: 1.12;
  }
  .hero__tagline-accent { color: var(--tippal-primary); }
  .hero__desc {
    max-width: 46ch;
    margin: 0;
    color: var(--tippal-text-secondary);
    font-size: 17px;
    line-height: 1.6;
  }
  .hero__stores { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 4px; }
  .hero__micro { color: var(--tippal-text-tertiary); font-size: 13.5px; font-weight: 600; }
  .hero__right { display: flex; justify-content: center; }
  .hero__card { padding: 28px 34px 40px; border-radius: 24px; background: #fff; box-shadow: var(--tippal-shadow-float); }
  .hero__card img { display: block; width: min(280px, 56vw); }

  @media (max-width: 560px) {
    .hero__grid { grid-template-columns: 1fr; gap: 36px; padding: 40px 20px 56px; }
    .hero__card { padding: 20px 24px 30px; }
  }
</style>
