---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HeroScroll from "../components/HeroScroll.astro";
import Marquee from "../components/Marquee.astro";
import Workers from "../components/Workers.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AppDemo from "../components/AppDemo.astro";
import Manifesto from "../components/Manifesto.astro";
import TheTruth from "../components/TheTruth.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="TipPal — Gratitude is human. No pressure."
  description="TipPal is the easiest way to send gratitude in person with Tap to Pay. The first app made exclusively for showing appreciation to the people who make your day."
  canonicalURL="/"
  hreflang={{ en: "/", es: "/es" }}
>
  <Nav />
  <main>
    <Hero />
    <HeroScroll />
    <Marquee />
    <Workers />
    <HowItWorks />
    <AppDemo />
    <Manifesto />
    <TheTruth />
  </main>
  <Footer />
</BaseLayout>