---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Workers from "../components/Workers.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AppDemo from "../components/AppDemo.astro";
import Manifesto from "../components/Manifesto.astro";
import TheTruth from "../components/TheTruth.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="TipPal — Thank the people who make your day."
  description="TipPal is the easiest way to send gratitude in person with Tap to Pay. Free to download, and every gift goes to people, not platforms."
  canonicalURL="/"
  hreflang={{ en: "/", es: "/es" }}
>
  <Nav />
  <main>
    <Hero />
    <Workers />
    <HowItWorks />
    <AppDemo />
    <Manifesto />
    <TheTruth />
  </main>
  <Footer />
</BaseLayout>