{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/forms/**",
              "components/money/**",
              "components/structure/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Fredoka))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Fredoka."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:balance|currency|isLoading|onLoadMoney|loadMoneyLabel|availableBalanceLabel|key|ref|className|style|children)$/]",
        "message": "<BalanceCard> doesn't accept that prop. Declared props: balance, currency, isLoading, onLoadMoney, loadMoneyLabel, availableBalanceLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onClick|variant|state|disabled|shape|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: title, onClick, variant, state, disabled, shape, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|loading|success|error)$/]",
        "message": "<Button> state must be one of 'idle' | 'loading' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill)$/]",
        "message": "<Button> shape must be one of 'square' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|error|success|helperText|variant|color|type|disabled|style|rightIcon|onRightIconPress|key|ref|className|style|children)$/]",
        "message": "<CustomInput> doesn't accept that prop. Declared props: label, placeholder, value, onChange, error, success, helperText, variant, color, type, disabled, style, rightIcon, onRightIconPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomInput'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|outline)$/]",
        "message": "<CustomInput> variant must be one of 'default' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomInput'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary|tertiary|accent)$/]",
        "message": "<CustomInput> color must be one of 'primary' | 'secondary' | 'tertiary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|spacing|color|size|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: text, spacing, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:subtle|medium|readable)$/]",
        "message": "<GlassCard> variant must be one of 'subtle' | 'medium' | 'readable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|showBack|onBack|rightAction|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: title, showBack, onBack, rightAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='KycBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:verificationStatus|currentlyDue|key|ref|className|style|children)$/]",
        "message": "<KycBadge> doesn't accept that prop. Declared props: verificationStatus, currentlyDue."
      },
      {
        "selector": "JSXOpeningElement[name.name='KycBadge'] > JSXAttribute[name.name='verificationStatus'] > Literal[value!=/^(?:NOT_STARTED|PENDING|VERIFIED|FAILED)$/]",
        "message": "<KycBadge> verificationStatus must be one of 'NOT_STARTED' | 'PENDING' | 'VERIFIED' | 'FAILED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|amount|recipientName|senderName|note|date|isLast|key|ref|className|style|children)$/]",
        "message": "<TransactionItem> doesn't accept that prop. Declared props: type, amount, recipientName, senderName, note, date, isLast."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:tip_sent|tip_received|load_money|withdrawal)$/]",
        "message": "<TransactionItem> type must be one of 'tip_sent' | 'tip_received' | 'load_money' | 'withdrawal'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
